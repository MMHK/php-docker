{
	admin off
    # 全局設定：定義速率限制區 (Rate Limit Zone)
    order rate_limit before basicauth
    order cache before rewrite
}
(log_file) {
	log {
		level ERROR
		output stdout
	}
}
(static) {
	@static {
		file
		path *.ico *.css *.js *.gif *.jpg *.jpeg *.png * .svg *.woff *.woff2 *.json *.webp
	}
	header @static Cache-Control max-age=5184000
}
(security) {
	header {
		# enable HSTS
		Strict-Transport-Security max-age=31536000;

		# disable clients from sniffing the media type
		# X-Content-Type-Options nosniff

		# clickjacking protection
		# X-Frame-Options SAMEORIGIN

		# keep referrer data off of HTTP connections
		# Referrer-Policy no-referrer-when-downgrade

		# Content Security Policy
		# Content-Security-Policy "base-uri 'self'; default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:"
	}
}
(production_error_hader) {
	handle_errors {
		root * /var/www/html
		rewrite * /errors.html
		templates
		file_server
	}
}
(internal_only) {
	@denied not remote_ip private_ranges
	abort @denied
}
(php_fpm) {
    @phpFiles {
        path *.php
    }
    php_fastcgi @phpFiles php:9000 {
        split .php
    }
}
(rewrite_index_php) {
    try_files {path} {path}/index.html {path}/index.php index.php
}
(waf) {
    coraza_waf {
        include /etc/coraza/coraza.conf-recommended
        include /etc/coraza/coreruleset/crs-setup.conf.example
        include /etc/coraza/coreruleset/rules/*.conf
    }
}
(defense_ratelimit) {
    rate_limit {
        zone defence_zone {
            key    {remote_host}
            events 5
            window 1s
        }
    }
}
(static_cache) {
    cache {
        # 設定要快取的檔案類型
        match_path *.png *.jpg *.jpeg *.gif *.webp *.css *.js *.svg *.ico *.woff *.woff2

        # 設定要快取的 Content-Type
        match_header Content-Type image/* text/css application/javascript font/*

        # 預設快取時間 (例如 24 小時)
        default_max_age 24h

        # (選用) 忽略 query string，防止 ?v=123 這種 Cache Busting 攻擊
        # key_fields {
        #     ignore_query_params yes
        # }
    }
}
(block_bad_guys) {
    @bad_actors {
        # 根據你的 Log 封鎖的惡意網段
        remote_ip 116.0.0.0/8 14.0.0.0/8

        # 封鎖可疑的 User-Agent
        header User-Agent "*Go-http-client*"
        header User-Agent "*curl*"
        header User-Agent "*python*"
    }
    respond @bad_actors "Access Denied" 403
}
(aws_transport_config) {
    transport http {
        # 讀取上游回應的 Body 逾時
        read_body 10s
        # 讀取上游回應 Header 逾時
        read_header 5s
        # 寫入請求給上游的逾時
        write 10s
        # 閒置連線保持時間
        idle 1m
    }
}
(std_site) {
	encode zstd gzip

	import log_file
	import static
	import security

	#    tls sam@mixmedia.com {
	#        dns dnspodcn {env.DNSPOD_APP_ID} {env.DNSPOD_APP_TOKEN}
	#    }

	header -Server
	header -X-Powered-By
	header Service-By "demo3-https"
	header X-Robots-Tag "noindex"

	respond /robots.txt "User-Agent: *
Disallow: /
Disallow: /*.php
Disallow: /*.swf" 200 {
		close
	}

	@bots {
		header User-Agent *bot*
	}

	respond @bots 403 {
		close
	}

	file_server

	import production_error_hader
}

:80 {
	root * /var/www/html

	import waf

    # import internal_only

    route {
        import rewrite_index_php
        import php_fpm
    }

	import std_site
}
