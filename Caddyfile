{
    admin off
}
(log_file) {
    log {
        level ERROR
        output stdout
    }
}
(static) {
    @static {
        file
        path *.ico *.css *.js *.gif *.jpg *.jpeg *.png * .svg *.woff *.woff2 *.json *.webp
    }
    header @static Cache-Control max-age=5184000
}
(security) {
    header {
        # enable HSTS
        Strict-Transport-Security max-age=31536000;

        # disable clients from sniffing the media type
        # X-Content-Type-Options nosniff

        # clickjacking protection
        # X-Frame-Options SAMEORIGIN

        # keep referrer data off of HTTP connections
        # Referrer-Policy no-referrer-when-downgrade

        # Content Security Policy
        # Content-Security-Policy "base-uri 'self'; default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:"
    }
}
(production_error_hader) {
    handle_errors {
        root * /var/www/default
        rewrite * /errors.html
        templates
        file_server
    }
}
(internal_only) {
    @denied not remote_ip private_ranges
    abort @denied
}
(std_site) {
    encode zstd gzip

    import log_file
    import static
    import security

    tls sam@mixmedia.com {
        dns dnspodcn {env.DNSPOD_APP_ID} {env.DNSPOD_APP_TOKEN}
    }

    header -Server
    header -X-Powered-By
    header Service-By "demo3-https"
    header X-Robots-Tag "noindex"

    respond /robots.txt "User-Agent: *
Disallow: /
Disallow: /*.php
Disallow: /*.swf" 200 {
        close
    }

    @bots {
        header User-Agent *bot*
    }

    respond @bots 403 {
        close
    }

    file_server

    import production_error_hader
}
:80 {
	root * /var/www/html
	encode zstd gzip

	log {
		level DEBUG
	}

	header -Server
	header -X-Powered-By

	route {
		@phpFiles {
			path *.php
		}
		@fileNotExist {
		   not file {path} {path}/index.html
		}

		rewrite @fileNotExist index.php
		php_fastcgi @phpFiles php:9000 {
			split .php
		}
	}

	file_server

	handle_errors {
		root * /etc/caddy/error
		rewrite * /error.html
		templates
		file_server
	}
}
